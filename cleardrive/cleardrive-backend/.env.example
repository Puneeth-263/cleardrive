PORT=5000

# Set to your deployed Netlify URL in production, e.g.
# FRONTEND_URL=https://cleardrive.netlify.app
FRONTEND_URL=

# MongoDB Atlas connection string. Without this, the backend falls back
# to reading/writing local JSON files (bookings won't persist across
# restarts). See README.md "Setting up a real database" section.
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cleardrive
MONGODB_URI=

# Secret used to sign login sessions (JWT). Use a long random string in
# production — e.g. run `openssl rand -hex 32` and paste the result here.
JWT_SECRET=

# Password for the /admin dashboard login. Pick your own strong password.
ADMIN_PASSWORD=
